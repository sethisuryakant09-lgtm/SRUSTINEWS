# Neon PostgreSQL — Pooled connection (used by app at runtime via Prisma + pgBouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_POOLER_HOST/neondb?sslmode=require&pgbouncer=true&channel_binding=require"

# Neon PostgreSQL — Direct connection (used by Prisma for migrations/schema push)
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channel_binding=require"

# Server
PORT=5000
NODE_ENV=production

# Optional: Protect the Vercel Cron endpoint
# CRON_SECRET="your_random_secret_here"
